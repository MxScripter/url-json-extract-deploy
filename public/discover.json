        "date": { "type": "string" }
      },
      "required": ["invoice_number", "date"]
    }
  },
  "responseExample": {
    "invoice_number": "42183017",
    "date": "August 3 , 2014"
  },
  "x402": {
    "version": 2,
    "scheme": "exact",
    "bazaar": true
  },
